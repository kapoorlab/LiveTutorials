# Copy to .env and fill in — .env is gitignored, this template is not.
#
#     cp .env.example .env
#
# Tutorials load .env automatically (python-dotenv), so you don't need to export
# anything by hand. Real shell exports still win over the file if you set both.
# Leave anything you don't use blank.

# ── GWDG Chat AI / SAIA ──────────────────────────────────────────────────────
# Key and endpoint GWDG gave you. The endpoint must end in /v1.
GWDG_API_KEY=
HF_API_KEY=
GWDG_BASE_URL=
GWDG_MODEL=qwen3-coder-next

# ── Ollama on the HPC (tutorials/ series) ────────────────────────────────────
# Port you forwarded with `ssh -N -L <port>:<node>:<port> ...`
OLLAMA_BASE_URL=http://localhost:9999

# PDF the document-converter tutorial converts.
PDF_PATH=../data/cell_fate.pdf
PDF_CHROMA_PATH=../data/chroma_cell_fate

GWDG_MODEL=qwen3-coder-next
GWDG_OPUS_MODEL=qwen3-coder-next       
GWDG_SONNET_MODEL=qwen3.6-27b            
GWDG_HAIKU_MODEL=gemma-4-31b-it              
GWDG_SMALL_FAST_MODEL=mistral-medium-3.5-128b           
GWDG_FABLE_MODEL=deepseek-v4-flash-0731      
