# Copy to .env and fill in — .env is gitignored, this template is not.
#
#     cp .env.example .env
#
# Tutorials load .env automatically (python-dotenv), so you don't need to export
# anything by hand. Real shell exports still win over the file if you set both.
# Leave anything you don't use blank.

# ── GWDG Chat AI / SAIA ──────────────────────────────────────────────────────
# Key and endpoint GWDG gave you. The endpoint must end in /v1.
GWDG_API_KEY=
GWDG_BASE_URL=
# Optional: default model when a script is run without a model argument.
GWDG_MODEL=

# ── Ollama on the HPC ────────────────────────────────────────────────────────
# Port you forwarded with `ssh -N -L <port>:<node>:<port> ...`
OLLAMA_BASE_URL=

# ── OpenAI (if a tutorial uses it) ───────────────────────────────────────────
OPENAI_API_KEY=

# ── Knowledge base paths (if a tutorial reads a prebuilt DB) ─────────────────
CHROMA_PATH=
